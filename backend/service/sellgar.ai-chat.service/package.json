{
  "private": true,
  "name": "@service/ai-chat",
  "version": "0.0.1",
  "description": "Canonical backend for AI Analytics Assistant chats",
  "license": "UNLICENSED",
  "packageManager": "yarn@4.10.3",
  "scripts": {
